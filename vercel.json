{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth-protected-resource" },
    { "source": "/oauth/consent", "destination": "/index.html" },
    { "source": "/book-with-ai", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/(.*)", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" }
  ]
}
